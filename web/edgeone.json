      "destination": "/terms/index.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/status",
      "destination": "/status/index.html"
    },
    {
      "source": "/status/",
      "destination": "/status/index.html"
    },
    {
      "source": "/verify",
      "destination": "/verify/index.html"
    },
    {
      "source": "/verify/",
      "destination": "/verify/index.html"
    },
    {
      "source": "/today",
      "destination": "/app-shell.html"
    },
    {
      "source": "/today/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/setup",
      "destination": "/app-shell.html"
    },
