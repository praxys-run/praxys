      "source": "/analysis/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/goal",
      "destination": "/app-shell.html"
    },
    {
      "source": "/goal/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/history",
      "destination": "/app-shell.html"
    },
