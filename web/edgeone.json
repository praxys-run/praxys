      "destination": "/product/index.html"
    },
    {
      "source": "/product/",
      "destination": "/product/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq/index.html"
    },
    {
      "source": "/zh/product",
      "destination": "/zh/product/index.html"
    },
    {
      "source": "/zh/product/",
      "destination": "/zh/product/index.html"
    },
    {
      "source": "/zh/faq",
