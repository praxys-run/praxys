    {
      "source": "/settings/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/mcp/authorize",
      "destination": "/app-shell.html"
    },
    {
      "source": "/mcp/authorize/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/labs/*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/*",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/login*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/terms*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
