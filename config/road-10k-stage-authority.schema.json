{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxys.run/schemas/road-10k-stage-authority-v1.json",
  "title": "Road 10K stage authority",
  "description": "Schema only. The application never writes or seeds this artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_digest",
    "stage_id",
    "capability_id",
    "object_id",
    "work_contract_digest",
    "route_digest",
    "schema_version",
    "control_schema_version",
    "state",
    "invitation_ceiling",
    "exposure_ceiling",
    "notice_digest",
    "cohort_rule_digest",
    "sampling_run_evidence_digest",
    "valid_from",
    "valid_until",
    "heartbeat_at",
    "heartbeat_max_age_seconds",
    "readiness",
    "provider_fence",
    "pause",
    "kill",
    "build_id"
  ],
  "properties": {
    "authority_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stage_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "capability_id": { "const": "outdoor_road_10k_performance_v1" },
    "object_id": { "const": "road-10k-controlled-opt-in-foundation-v1" },
    "work_contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "route_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema_version": { "const": "road-10k-stage-authority-v1" },
    "control_schema_version": { "const": 2 },
    "state": {
      "enum": [
        "active",
        "off",
        "paused",
        "killed",
        "hold",
        "rollback",
        "stopped",
        "revision"
      ]
    },
    "invitation_ceiling": { "type": "integer", "minimum": 0, "maximum": 60 },
    "exposure_ceiling": { "type": "integer", "minimum": 0, "maximum": 30 },
    "notice_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cohort_rule_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sampling_run_evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" },
    "heartbeat_max_age_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "readiness": { "enum": ["ready", "not_ready"] },
    "provider_fence": { "enum": ["closed", "open", "unknown"] },
    "pause": { "type": "boolean" },
    "kill": { "type": "boolean" },
    "build_id": { "type": "string", "minLength": 1, "maxLength": 120 }
  }
}
