# Praxys Server Configuration
# Copy this file to .env and fill in your values.
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Migration note: legacy TRAINSIGHT_* env vars are still read for backward
# compatibility and will be removed after 2026-05-19. Prefer PRAXYS_* for
# all new deployments.

# Required: Encryption key for stored platform credentials
# Without this, credentials won't survive server restarts.
PRAXYS_LOCAL_ENCRYPTION_KEY=

# --- Database ---
# Which database the backend uses. Leave UNSET for local dev + tests: the
# app uses a SQLite file at DATA_DIR/trainsight.db (default ./data).
#
# Set PRAXYS_DATABASE_URL to a PostgreSQL DSN to use Postgres (#360). Both
# postgres:// and postgresql:// are accepted and normalized to the psycopg3
# driver; the same URL backs the sync and async engines. On Postgres the
# schema is managed by Alembic (alembic upgrade head runs on boot under an
# advisory lock); SQLite dev/test DBs use create_all.
#   PRAXYS_DATABASE_URL=postgresql://user:password@host:5432/praxys?sslmode=require
#
# Azure Database for PostgreSQL with Entra (Managed Identity) auth: omit the
# password and set PRAXYS_DB_AUTH=entra. The app then fetches a short-lived
# AAD token from its managed identity as the DB password (no secret in app
# settings). The MI must be a Postgres AAD role. docs/ops/config-and-secrets.md.
#   PRAXYS_DATABASE_URL=postgresql://<aad-user>@<server>.postgres.database.azure.com:5432/praxys?sslmode=require
#   PRAXYS_DB_AUTH=entra
#
# Connection-pool sizing (optional; defaults suit a Burstable tier):
#   PRAXYS_DB_POOL_SIZE=5
#   PRAXYS_DB_MAX_OVERFLOW=5
#   PRAXYS_DB_POOL_RECYCLE=1800
# PRAXYS_DATABASE_URL=
# PRAXYS_DB_AUTH=

# --- Labs isolated analysis compute (#619) ---
# Local development defaults to inline execution. Production should switch to
# service_bus only after docs/ops/labs-analysis-worker.md has provisioned and
# verified the queue, worker identity/DB principal, Container Apps Job, and
# alerts. A configured service_bus mode never falls back to API-process compute.
#   PRAXYS_LABS_EXECUTION_MODE=inline       # inline | service_bus | disabled
# The backend deployment derives these from the tagged Azure namespace; they
# are shown here only for local integration testing.
#   PRAXYS_LABS_SERVICE_BUS_FQDN=sb-....servicebus.windows.net
#   PRAXYS_LABS_SERVICE_BUS_QUEUE=labs-environment-response
# Optional App Service user-assigned identity client ID for queue sends. When
# unset, the backend uses its system-assigned identity. The worker continues to
# use its Bicep-provided AZURE_CLIENT_ID.
#   PRAXYS_LABS_SERVICE_BUS_CLIENT_ID=
# Worker-only defense: omit SQL bind values from SQLAlchemy exception text.
#   PRAXYS_HIDE_SQL_PARAMETERS=true

# JWT secret for auth tokens.
#   The app refuses to boot in any environment that isn't explicitly marked
#   as dev. Set PRAXYS_ENV=development for local work without a secret (a
#   random per-process secret is generated; reloads invalidate sessions),
#   or provide an explicit value here / in App Service configuration.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PRAXYS_JWT_SECRET=
# PRAXYS_ENV=development

# Default-off operator gate for unsupported Garmin consumer-API workout
# delivery. User consent is also required. Enable only in an approved
# validation deployment; production should remain false until the controlled
# international and China lifecycle matrices both pass.
PRAXYS_GARMIN_PLAN_DELIVERY_ENABLED=false

# Optional: Admin email — this email can register without an invitation code
# and is always granted admin privileges. Not needed if you're the first user.
# PRAXYS_ADMIN_EMAIL=

# Optional: Authentication rate limiter (api/auth_rate_limit.py).
#   Caps per-IP attempts on /api/auth/login, /api/auth/register, and the
#   /api/auth/wechat/* endpoints. Enabled by default in any deployment.
#   Set to "true" to disable for tests / local development. Adjust
#   PRAXYS_TRUSTED_PROXY_HOPS when you have multiple reverse proxies in
#   front of the app (default 1 = trust the rightmost X-Forwarded-For
#   entry, which is correct for a vanilla Azure App Service deployment).
# PRAXYS_AUTH_RATE_LIMIT_DISABLED=false
# PRAXYS_TRUSTED_PROXY_HOPS=1

# Optional: Strava OAuth app credentials for browser-based Strava connect.
# Activities-only sync uses these to exchange and refresh tokens.
# Register the callback URL shown below in your Strava app settings.
# PRAXYS_STRAVA_CLIENT_ID=
# PRAXYS_STRAVA_CLIENT_SECRET=

# Optional: Override the callback URL used in the Strava OAuth flow.
# Leave unset in local dev to use the app's detected callback route.
# PRAXYS_STRAVA_REDIRECT_URI=https://your-api.example.com/api/settings/connections/strava/callback

# Optional: backend-only Azure Application Insights routing for production
# observability (traces, metrics, logs). When set, the app auto-ships
# per-request timings + DB dependency spans + Python logs to that component.
# Leave unset locally — app runs fine without it.
#
# On Azure App Service, the server authenticates to App Insights via the
# App Service's system-assigned managed identity by default (no secret in
# app settings). If AZURE_CLIENT_ID is configured, the matching attached
# user-assigned identity is used instead. The connection string is only used
# for routing. Production
# resolves it from the backend component named in
# .github/azure-observability.env. That component disables local auth so a
# browser-held instrumentation key cannot forge trusted backend events. The
# MI must hold "Monitoring Metrics Publisher" and "Monitoring Reader" on that
# exact resource — see docs/ops/config-and-secrets.md.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# The deploy workflow derives this non-secret resource ID from
# .github/azure-observability.env. It enables the admin operations console to
# query aggregate-only trusted telemetry; leave unset locally to disable those
# sections.
# PRAXYS_BACKEND_APPINSIGHTS_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.Insights/components/appi-praxys-backend

# Azure AI is a mandatory ordinary-production service capability for bilingual
# insights (post-sync daily_brief / training_review / race_forecast). Configure
# AZURE_AI_ENDPOINT for ordinary service. Auth uses DefaultAzureCredential (no
# API key); the same scaffolding powers the i18n translation pipeline in
# scripts/translate_missing.py.
#
# During emergency degradation, use the central stop below: AI-only features
# report explicitly unavailable. Deterministic metrics in analysis/metrics.py
# continue separately; they are not an AI-branded or rule-based fallback.
#
# AZURE_AI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# PRAXYS_INSIGHT_MODEL=gpt-5.4              # reasoning model deployment for insights
# TRANSLATE_MODEL=gpt-5.4-mini              # smaller model for new i18n strings
# TRANSLATE_REVIEW_MODEL=gpt-5.4            # stronger model for native-copy review
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# PRAXYS_INSIGHT_DAILY_CAP=30               # max LLM generations per user per UTC day
# Independent China web processing gate. Production launch/disable is owned by
# the protected launch-cn workflow; keep true for local development unless
# explicitly testing the China client boundary.
PRAXYS_DISABLE_CN_PROCESSING=true
# Separate Miniapp emergency boundary. Ordinary production keeps the existing
# Miniapp enabled; invalid or missing production configuration still fails closed.
PRAXYS_DISABLE_MINIAPP_PROCESSING=false
# Central Azure AI emergency stop. It defaults to true when absent or invalid.
# Ordinary service sets this false; current Terms receipts authorize the
# enumerated AI purposes. China processing remains independently controlled;
# China launch and backend deployment never toggle this setting.
PRAXYS_DISABLE_BACKGROUND_AI=false
# Negative compliance kill switch for publication of user feedback to external
# issue trackers. Feedback remains private in the Praxys database for admin
# handling. Production keeps this true until each publication has an explicit,
# purpose-specific user action and disclosure.
PRAXYS_ENABLE_FEEDBACK_PUBLICATION=false
PRAXYS_DISABLE_FEEDBACK_PUBLICATION=true

# Optional: Statsig feature gates and dynamic config. The server SDK key is
# secret and backend-only. When it is unset every gate is false and dynamic
# config callers keep their environment/default fallback.
# STATSIG_SDK_KEY=
# STATSIG_ENV=development                    # development | staging | production
# Console config: labs_environment_recompute_policy (defaults remain 6h / 24h / 3)

# Optional: In-app feedback → GitHub issue auto-filing.
# When a user submits feedback (bug / feature / other) from the web app or
# WeChat mini program, it's stored in the DB and a background task PII-scrubs
# + (optionally) AI-classifies it, then opens a GitHub issue so an agent can
# triage / fix it. If these are unset, feedback is still captured and an admin
# can promote it manually from the Admin page — only the auto-issue step is
# skipped.
#
# Recommended target: the SAME repo as the code (e.g. praxys-run/praxys) so the
# GitHub Copilot coding agent assigned the issue can open a fix PR in-repo.
#
# Auth uses a GitHub App (no token to rotate): the backend mints short-lived
# installation tokens on demand and caches them. The app needs "Issues: write"
# on the repo; the PEM private key may be stored single-line with \n escapes.
# Setup: docs/ops/setup-github-app.md
# PRAXYS_GITHUB_APP_ID=
# PRAXYS_GITHUB_APP_INSTALLATION_ID=
# PRAXYS_GITHUB_APP_PRIVATE_KEY=
# PRAXYS_FEEDBACK_GITHUB_REPO=praxys-run/praxys
#
# SECURITY: this repo is PUBLIC, so two layers protect against leaks before an
# issue is filed: (1) a deterministic PII/secret scrub on everything published,
# and (2) an AI "sensitivity gate" — if the model judges a (scrubbed) report
# still risks personal / health / credential content, it is NOT auto-filed; it
# is parked as "needs_review" for an admin to approve from the Admin page.
# Reports where the scrubber caught a key/token are always parked. Prefer total
# privacy instead? Point the repo above at a PRIVATE one — but note an agent
# there can't open PRs against the public code repo.
#
# When Azure OpenAI is NOT configured there is no AI gate, so by default nothing
# auto-files to the public repo (everything is parked for admin review). Set
# this to true to allow scrub-only auto-filing without the AI gate (you accept
# the residual risk).
# PRAXYS_FEEDBACK_AUTOFILE_WITHOUT_AI=false
#
# Comma-separated labels added to every filed issue (e.g. a label your coding
# agent automation watches so it auto-picks-up the issue). Optional.
# PRAXYS_FEEDBACK_GITHUB_LABELS=
# Comma-separated GitHub logins to assign (e.g. the Copilot coding-agent bot
# once enabled on the repo). Optional. NOTE: this assigns EVERY filed issue.
# The change loop (Loop A, issue #362) is the selective alternative: triage
# auto-adds the `agent-ready` label only to qualifying, actionable bugs, and
# .github/workflows/assign-copilot.yml assigns the Copilot coding agent from
# that label. Prefer the change loop over a blanket assignee. See
# docs/ops/change-loop.md.
# PRAXYS_FEEDBACK_GITHUB_ASSIGNEES=
#
# Change loop shadow mode: compute the agent-ready decision and log it WITHOUT
# applying the label (nothing is auto-assigned). Use it to measure precision on
# real feedback before trusting the loop, then unset. See docs/ops/change-loop.md.
# PRAXYS_AGENT_READY_SHADOW=false
# Optional semantic challenger: run the named versioned prompt on the same
# scrubbed feedback and persist its decision without changing labels. Blank is
# off; currently supported: v2. Priority remains independent of readiness.
# PRAXYS_AGENT_READY_CHALLENGER_PROMPT_VERSION=
#
# Admin notification: parked (needs_review) reports show as a badge on the
# Admin sidebar. To also EMAIL admins, wire an Azure Monitor alert on the
# praxys.feedback metric (status=needs_review) — no app code needed. Steps +
# KQL: docs/ops/monitoring-and-alerts.md

# Optional: screenshot attachments on feedback (issue #337). Users may attach
# up to 3 images (png/jpg/webp, <=5 MB each). Images are stored PRIVATELY and
# are never published to a public issue — a vision model reads each screenshot,
# writes a PII-scrubbed text description for the issue, and flags sensitivity
# (which feeds the same needs_review gate as the text path).
#
# Storage backend (unset = local filesystem under DATA_DIR — fine for dev, but
# EPHEMERAL on Azure App Service, so configure Blob in production). Set the
# container plus ONE credential path:
#   PRAXYS_FEEDBACK_BLOB_CONTAINER=feedback-screenshots
#   PRAXYS_FEEDBACK_BLOB_CONNECTION_STRING=...      # account key / SAS, OR
#   PRAXYS_FEEDBACK_BLOB_ACCOUNT_URL=https://<acct>.blob.core.windows.net  # keyless (DefaultAzureCredential)
# (Tencent COS for the CN audience is a future backend, post-ICP.)
#
# Vision model deployment used to describe + sensitivity-flag screenshots.
# Defaults to PRAXYS_INSIGHT_MODEL (the gpt-5.x / gpt-4o families are
# multimodal) and reuses AZURE_AI_ENDPOINT above. When no AI is configured,
# attached screenshots are stored + referenced but the report is parked for
# admin review (never auto-published without a sensitivity verdict).
# PRAXYS_VISION_MODEL=gpt-5.4

# Optional: transactional email (SMTP) — used for (1) email-ownership
# verification of open self-registration sign-ups and (2) emailing invitation
# codes to waitlist signups from the Admin page. Built for WeCom / Tencent
# Exmail (smtp.exmail.qq.com:465, implicit TLS) using a client authorization
# code as the password, but works with any authenticated SMTP relay.
#
# ALL OPTIONAL — leave unset and the feature degrades gracefully: invitation
# codes are generated + shown for the admin to copy/mailto by hand, and open
# self-registration (if you enable it) creates VERIFIED accounts because no
# email-ownership check is possible. Configure these to enable both.
#
# Security: PRAXYS_SMTP_PASSWORD is a secret (an app/authorization code, not
# your mailbox password) — never commit it. TLS is mandatory (no plaintext
# fallback). Azure App Service blocks outbound port 25 but allows 465/587.
# PRAXYS_SMTP_HOST=smtp.exmail.qq.com
# PRAXYS_SMTP_PORT=465                      # 465 = implicit TLS (default); 587 = STARTTLS
# PRAXYS_SMTP_USER=no-reply@praxys.run
# PRAXYS_SMTP_PASSWORD=                     # Exmail 客户端授权码 (client authorization code)
# PRAXYS_SMTP_FROM=Praxys <no-reply@praxys.run>   # defaults to PRAXYS_SMTP_USER
# PRAXYS_SMTP_STARTTLS=false                # set true only if using port 587

# Optional: public origin used to build verify/invite links in those emails.
# Defaults to https://praxys.run when unset. Set to your own origin for a
# self-hosted deployment (e.g. http://localhost:5173 in dev).
# PRAXYS_APP_BASE_URL=https://praxys.run

# NOTE: the self-registration gate (open/closed) and the seat cap are NOT env
# vars — they are operator-managed at runtime from the Admin page (stored in
# the app_config DB table; see api/app_config.py and docs/ops/admin-tasks.md).
