{
  "hook": {
    "enabled": true,
    "limits": {
      "maxFindings": 5,
      "maxChars": 8000
    }
  },
  "detector": {
    "ignoreRules": [],
    "ignoreFiles": [
      ".github/skills/impeccable/**"
    ],
    "ignoreValues": [
      {
        "rule": "overused-font",
        "value": "Geist",
        "files": ["web/src/pages/ActivityDetail.css"],
        "reason": "The approved Praxys Field Lab activity-detail specification explicitly chooses Geist for this page; keep the existing brand typography."
      }
    ],
    "extensions": [
      {
        "ext": ".wxml",
        "engine": "html"
      },
      {
        "ext": ".wxss",
        "engine": "text"
      }
    ]
  }
}
