{
  "description": "Praxys Impeccable post-edit validation for Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
