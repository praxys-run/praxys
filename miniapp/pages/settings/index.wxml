<view class="settings-root {{themeClass}}">
  <nav-bar title="{{tr.navTitle}}" theme-class="{{themeClass}}" />

  <scroll-view scroll-y="{{true}}" class="settings-scroll">
    <view class="settings-content">
    <block wx:if="{{loading && !hasResponse}}">
      <state-card type="loading" />
    </block>

    <block wx:elif="{{errorMessage}}">
      <state-card type="error" headline="{{tr.failedToLoad}}" detail="{{errorMessage}}" show-retry bindretry="onRetry" />
    </block>

    <block wx:elif="{{hasResponse}}">
      <view class="ts-section">
        <text class="ts-section-label">{{tr.profile}}</text>
        <view
          wx:for="{{profileRows}}"
          wx:key="label"
          class="settings-row"
        >
          <text class="settings-label ts-muted">{{item.label}}</text>
          <text class="settings-value ts-value">{{item.value}}</text>
        </view>
      </view>

      <view class="ts-section">
        <view class="settings-section-header">
          <text class="ts-section-label settings-section-header-label">{{tr.connections}}</text>
          <view
            wx:if="{{hasConnections}}"
            class="settings-section-action {{syncing ? 'settings-section-action--spinning' : ''}}"
            hover-class="settings-section-action--press"
            bindtap="onSyncAll"
            aria-label="{{syncing ? tr.syncing : tr.syncNow}}"
          >
            <view class="settings-section-action-icon settings-section-action-icon--refresh"></view>
          </view>
        </view>
        <block wx:if="{{hasConnections}}">
          <view
            wx:for="{{connectionRows}}"
            wx:key="key"
            class="settings-row"
          >
            <text class="settings-label ts-muted">{{item.label}}</text>
            <text class="settings-value ts-value">{{tr.connected}}</text>
          </view>
          <text wx:if="{{syncMessage}}" class="settings-hint ts-muted">{{syncMessage}}</text>
          <text class="settings-hint ts-muted">{{tr.manageOnWeb}}</text>
        </block>
        <text wx:else class="settings-empty ts-muted">{{tr.noPlatformsHint}}</text>
      </view>

      <view class="ts-section settings-plan">
        <view class="settings-plan-head">
          <text class="ts-section-label settings-plan-label">{{tr.planManagement}}</text>
          <text class="settings-plan-state settings-plan-state--{{planManagementState}}">
            {{planStateLabel}}
          </text>
        </view>
        <text class="settings-plan-title">{{planStateTitle}}</text>
        <text class="settings-plan-detail">{{planStateDetail}}</text>

        <view class="settings-plan-boundary">
          <view class="settings-plan-boundary-mark"></view>
          <text>{{tr.ownershipBoundary}}</text>
        </view>

        <view class="settings-plan-preview">
          <view class="settings-plan-preview-head">
            <view>
              <text class="settings-plan-preview-title">{{tr.managedWindow}}</text>
              <text wx:if="{{planWindowLabel}}" class="settings-plan-preview-window ts-value">
                {{planWindowLabel}}
              </text>
            </view>
            <view wx:if="{{hasPlanPreview}}" class="settings-plan-preview-stats">
              <text>
                <text class="ts-value">{{planPraxysCount}}</text> Praxys
              </text>
              <text wx:if="{{planExternalCount}}">
                <text class="ts-value">{{planExternalCount}}</text> {{tr.external}}
              </text>
            </view>
          </view>

          <view wx:if="{{planLoading}}" class="settings-plan-preview-loading">
            <view class="ts-skeleton settings-plan-skeleton"></view>
            <view class="ts-skeleton settings-plan-skeleton settings-plan-skeleton--short"></view>
          </view>
          <view wx:elif="{{planPreviewError}}" class="settings-plan-preview-error">
            <view>
              <text class="settings-plan-preview-error-title">{{tr.previewFailed}}</text>
              <text class="settings-plan-preview-error-detail">{{planPreviewError}}</text>
            </view>
            <button class="settings-plan-link" bindtap="refetchPlan">{{tr.retryPreview}}</button>
          </view>
          <block wx:elif="{{hasPlanPreview}}">
            <view wx:if="{{planPreviewRows.length}}" class="settings-plan-preview-list">
              <view
                wx:for="{{planPreviewRows}}"
                wx:key="key"
                class="settings-plan-preview-row"
              >
                <text class="settings-plan-preview-date ts-value">{{item.date}}</text>
                <view class="settings-plan-preview-copy">
                  <text class="settings-plan-preview-workout">{{item.workoutType}}</text>
                  <text wx:if="{{item.details}}" class="settings-plan-preview-details ts-value">{{item.details}}</text>
                </view>
              </view>
              <text wx:if="{{planPreviewMoreCount}}" class="settings-plan-preview-more">
                +{{planPreviewMoreCount}}
              </text>
            </view>
            <text wx:else class="settings-plan-preview-empty">{{tr.noPraxysWorkouts}}</text>
          </block>
        </view>

        <view
          wx:if="{{garminExperimentVisible}}"
          class="settings-plan-experiment"
        >
          <view class="settings-plan-experiment-head">
            <view class="settings-plan-experiment-copy">
              <view class="settings-plan-experiment-title-row">
                <text class="settings-plan-experiment-title">
                  {{tr.garminExperimentalTitle}}
                </text>
                <text class="settings-plan-experiment-state settings-plan-experiment-state--{{garminExperimentEnabled ? 'on' : 'off'}}">
                  {{!garminExperimentAvailable
                    ? tr.garminExperimentalUnavailable
                    : garminExperimentEnabled
                      ? tr.garminExperimentalEnabled
                      : tr.garminExperimentalOff}}
                </text>
              </view>
              <text class="settings-plan-experiment-detail">
                {{!garminExperimentAvailable
                  ? tr.garminExperimentalUnavailableDetail
                  : garminExperimentConnected
                  ? garminExperimentEnabled
                    ? tr.garminExperimentalOnDetail
                    : tr.garminExperimentalOffDetail
                  : tr.garminExperimentalReconnect}}
              </text>
            </view>
            <button
              wx:if="{{garminExperimentConnected && garminExperimentAvailable}}"
              class="ts-button ts-button--secondary settings-plan-experiment-action"
              disabled="{{garminExperimentAction || planAction}}"
              bindtap="onReviewGarminExperiment"
            >
              {{garminExperimentAction
                ? tr.garminExperimentalSaving
                : garminExperimentEnabled
                  ? tr.garminExperimentalDisable
                  : tr.garminExperimentalReview}}
            </button>
          </view>
          <text
            wx:if="{{garminExperimentError}}"
            class="settings-plan-error"
            role="alert"
          >{{garminExperimentError}}</text>
        </view>

        <view
          class="settings-pick-row settings-plan-target {{planManagementState !== 'external' || !planTargetOptions.length ? 'settings-plan-target--static' : ''}}"
          bindtap="onPickPlanTarget"
        >
          <text class="settings-pick-label">{{tr.executionTarget}}</text>
          <view class="settings-pick-right">
            <text class="settings-pick-value ts-value">
              {{planManagementState === 'external' ? selectedPlanTargetLabel : configuredPlanTargetLabel}}
            </text>
            <text
              wx:if="{{planManagementState === 'external' && planTargetOptions.length}}"
              class="settings-pick-chev ts-muted"
            >›</text>
          </view>
        </view>
        <text
          wx:if="{{planManagementState === 'external'}}"
          class="settings-plan-target-hint"
        >
          {{planTargetOptions.length ? tr.targetSelectionHint : tr.connectTargetHint}}
        </text>
        <text
          wx:elif="{{!configuredPlanTargetConnected}}"
          class="settings-plan-target-hint settings-plan-target-hint--warning"
        >{{tr.connectTargetHint}}</text>

        <view class="settings-plan-actions">
          <block wx:if="{{planManagementState === 'external'}}">
            <button
              class="ts-button settings-plan-action"
              disabled="{{planAction || planLoading || planCleanupPartial || !hasPlanPreview || !selectedPlanTarget}}"
              bindtap="onReviewManagedPlan"
            >
              {{planAction === 'adopt' ? tr.enabling : tr.reviewAndActivate}}
            </button>
            <button
              wx:if="{{!planCleanupPartial}}"
              class="ts-button ts-button--secondary settings-plan-action"
              disabled="{{planAction || planLoading}}"
              bindtap="onRemoveFuturePlanDeliveries"
            >{{tr.removeFutureDeliveries}}</button>
          </block>
          <block wx:elif="{{planManagementState === 'active'}}">
            <button
              class="ts-button ts-button--secondary settings-plan-action"
              disabled="{{planAction || planLoading}}"
              bindtap="onPauseManagedPlan"
            >{{planAction === 'pause' ? tr.pausing : tr.pauseDelivery}}</button>
            <button
              class="ts-button ts-button--ghost settings-plan-action"
              disabled="{{planAction || planLoading}}"
              bindtap="onLeaveManagedPlan"
            >{{planAction === 'leave' || planAction === 'cleanup' ? tr.leaving : tr.leaveManagedMode}}</button>
          </block>
          <block wx:else>
            <button
              class="ts-button settings-plan-action"
              disabled="{{planAction || planLoading || planCleanupPartial || !hasPlanPreview || !configuredPlanTargetConnected}}"
              bindtap="onReviewManagedPlan"
            >{{planAction === 'resume' ? tr.enabling : tr.reviewAndResume}}</button>
            <button
              class="ts-button ts-button--ghost settings-plan-action"
              disabled="{{planAction || planLoading}}"
              bindtap="onLeaveManagedPlan"
            >{{planAction === 'leave' || planAction === 'cleanup' ? tr.leaving : tr.leaveManagedMode}}</button>
          </block>
        </view>

        <view wx:if="{{adjustmentSupported}}" class="settings-adjustment">
          <view class="settings-adjustment-head">
            <view class="settings-adjustment-copy">
              <view class="settings-adjustment-title-row">
                <text class="settings-adjustment-title">{{tr.automaticGuardrail}}</text>
                <text class="settings-adjustment-state settings-adjustment-state--{{adjustmentEnabled ? 'on' : 'off'}}">
                  {{adjustmentEnabled ? tr.on : tr.off}}
                </text>
              </view>
              <text class="settings-adjustment-detail">
                {{planManagementState === 'external'
                  ? tr.adoptBeforeAutomatic
                  : adjustmentEnabled
                    ? tr.automaticEnabledDetail
                    : tr.suggestionOnlyDetail}}
              </text>
            </view>
            <button
              wx:if="{{planManagementState !== 'external'}}"
              class="ts-button ts-button--secondary settings-adjustment-action"
              disabled="{{adjustmentAction || planAction || planLoading}}"
              bindtap="onReviewAutomaticAdjustment"
            >
              {{adjustmentEnabled
                ? adjustmentAction === 'disable' ? tr.turningOff : tr.turnOff
                : tr.reviewAndTurnOn}}
            </button>
          </view>

          <button
            class="settings-plan-link settings-adjustment-science"
            bindtap="onShowAdjustmentScience"
          >{{tr.whyConservative}}</button>
          <text class="settings-adjustment-science-copy">{{tr.conservativeDetail}}</text>
          <view class="settings-adjustment-sources">
            <button
              class="settings-plan-link settings-adjustment-source"
              data-source="plews"
              bindtap="onCopyAdjustmentSource"
            >{{tr.plewsSource}}</button>
            <button
              class="settings-plan-link settings-adjustment-source"
              data-source="kiviniemi"
              bindtap="onCopyAdjustmentSource"
            >{{tr.kiviniemiSource}}</button>
          </view>

          <view wx:if="{{planAdjustmentRows.length}}" class="settings-adjustment-history">
            <text class="settings-adjustment-history-title">{{tr.recentAutomaticChanges}}</text>
            <view
              wx:for="{{planAdjustmentRows}}"
              wx:key="id"
              class="settings-adjustment-row"
            >
              <view class="settings-adjustment-row-copy">
                <view class="settings-adjustment-row-head">
                  <text class="settings-adjustment-date ts-value">{{item.date}}</text>
                  <text class="settings-adjustment-change">{{item.change}}</text>
                  <text class="settings-adjustment-status">{{item.status}}</text>
                </view>
                <text class="settings-adjustment-row-detail">{{item.detail}}</text>
              </view>
              <button
                wx:if="{{item.canUndo}}"
                class="settings-plan-link settings-adjustment-undo"
                data-id="{{item.id}}"
                disabled="{{adjustmentAction}}"
                bindtap="onUndoPlanAdjustment"
              >{{adjustmentAction ? tr.restoring : tr.restoreWorkout}}</button>
            </view>
          </view>

          <text wx:if="{{adjustmentError}}" class="settings-plan-error" role="alert">
            {{adjustmentError}}
          </text>
        </view>

        <view
          wx:if="{{planCleanupPartial && planManagementState === 'external'}}"
          class="settings-plan-cleanup"
          role="alert"
        >
          <text class="settings-plan-cleanup-title">{{tr.cleanupIncomplete}}</text>
          <view class="settings-plan-cleanup-counts">
            <text>{{tr.removed}} <text class="ts-value">{{planCleanupRemoved}}</text></text>
            <text>{{tr.remaining}} <text class="ts-value">{{planCleanupRemaining}}</text></text>
            <text wx:if="{{planCleanupTarget}}" class="ts-value">{{planCleanupTarget}}</text>
          </view>
          <button
            class="ts-button ts-button--secondary settings-plan-action settings-plan-cleanup-action"
            disabled="{{planAction || planLoading}}"
            bindtap="onRetryPlanCleanup"
          >{{planAction === 'cleanup' ? tr.removing : tr.retryCleanup}}</button>
        </view>
        <text wx:if="{{planActionError}}" class="settings-plan-error" role="alert">
          {{planActionError}}
        </text>
      </view>

      <view class="ts-section">
        <view class="settings-pick-row" bindtap="onPickTrainingBase">
          <text class="settings-pick-label ts-muted">{{tr.trainingBase}}</text>
          <view class="settings-pick-right">
            <text class="settings-pick-value ts-value">{{trainingBaseLabel}}</text>
            <text class="settings-pick-chev ts-muted">›</text>
          </view>
        </view>
        <text class="settings-hint ts-muted">{{tr.trainingBaseHint}}</text>
      </view>

      <view class="ts-section">
        <text class="ts-section-label">{{tr.thresholds}}</text>
        <block wx:if="{{hasThresholds}}">
          <view
            wx:for="{{thresholdRows}}"
            wx:key="key"
            class="settings-row"
          >
            <view>
              <text class="settings-label ts-muted">{{item.label}}</text>
              <text wx:if="{{item.hasOrigin}}" class="settings-origin ts-muted">{{item.origin}}</text>
            </view>
            <text class="settings-value ts-value">{{item.display}}</text>
          </view>
          <text class="settings-hint ts-muted">{{tr.thresholdsHint}}</text>
        </block>
        <text wx:else class="settings-empty ts-muted">{{tr.thresholdsEmpty}}</text>
      </view>

      <!-- Tappable nav row keeps a card surface for affordance — the
           chevron + tap area need to feel pressable. -->
      <view class="ts-card settings-nav-card" bindtap="onNavigateToScience">
        <view class="settings-nav-row">
          <view>
            <text class="settings-nav-title">{{tr.trainingScience}}</text>
            <text class="settings-nav-sub ts-muted">{{tr.scienceSubtitle}}</text>
          </view>
          <text class="settings-nav-chevron ts-muted">›</text>
        </view>
      </view>

      <view class="ts-section">
        <view class="settings-pick-row" bindtap="onPickTheme">
          <text class="settings-pick-label ts-muted">{{tr.theme}}</text>
          <view class="settings-pick-right">
            <text class="settings-pick-value ts-value">{{themeLabel}}</text>
            <text class="settings-pick-chev ts-muted">›</text>
          </view>
        </view>
        <view class="settings-pick-row" bindtap="onPickLanguage">
          <text class="settings-pick-label ts-muted">{{tr.language}}</text>
          <view class="settings-pick-right">
            <text class="settings-pick-value ts-value">{{languageLabel}}</text>
            <text class="settings-pick-chev ts-muted">›</text>
          </view>
        </view>
      </view>

      <view class="settings-actions">
        <button class="ts-button ts-button--secondary settings-action-btn" bindtap="onSendFeedback">
          {{tr.sendFeedback}}
        </button>
        <button class="ts-button ts-button--secondary settings-action-btn" bindtap="onCopyUrl">
          {{tr.openOnWeb}}
        </button>
        <button class="ts-button ts-button--secondary settings-action-btn" bindtap="onExportDataOnWeb">
          {{tr.exportDataOnWeb}}
        </button>
        <text class="settings-hint ts-muted">{{tr.exportDataOnWebHint}}</text>
        <button class="ts-button ts-button--secondary settings-action-btn" bindtap="onSwitchAccount">
          {{tr.switchAccount}}
        </button>
        <text class="settings-hint ts-muted">{{tr.switchAccountHint}}</text>
        <button class="ts-button ts-button--secondary settings-action-btn settings-action-btn--danger" bindtap="onDeleteAccount">
          {{tr.deleteAccount}}
        </button>
        <text class="settings-hint ts-muted">{{tr.deleteAccountHint}}</text>
        <button class="ts-button ts-button--secondary settings-action-btn" bindtap="onSignOut">
          {{tr.signOut}}
        </button>
      </view>

      <text wx:if="{{appVersion}}" class="settings-version ts-muted">{{appVersion}}</text>
    </block>
    </view>
  </scroll-view>
</view>
