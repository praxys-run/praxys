<view class="labs-catalog-root {{themeClass}}">
  <nav-bar title="{{tr.navTitle}}" theme-class="{{themeClass}}" show-back="{{true}}" />

  <scroll-view scroll-y="{{true}}" class="labs-catalog-scroll">
    <view class="labs-catalog-content">
      <text class="labs-catalog-intro">{{tr.intro}}</text>

      <block wx:if="{{loading}}">
        <state-card type="loading" />
      </block>
      <block wx:elif="{{errorMessage}}">
        <state-card type="error" headline="{{tr.failedToLoad}}" detail="{{errorMessage}}" show-retry bindretry="onRetry" />
      </block>
      <block wx:else>
        <text class="labs-catalog-heading">{{tr.availableExperiments}}</text>
        <text class="labs-catalog-detail">{{tr.experimentsDetail}}</text>

        <view class="ts-card labs-catalog-experiment" bindtap="onOpenEnvironment">
          <view class="labs-catalog-icon">
            <view class="labs-catalog-flask-neck"></view>
            <view class="labs-catalog-flask-body"></view>
          </view>
          <view class="labs-catalog-copy">
            <view class="labs-catalog-title-row">
              <text class="labs-catalog-title">{{tr.environmentTitle}}</text>
              <text class="labs-catalog-status">{{statusLabel}}</text>
            </view>
            <text class="labs-catalog-description">{{tr.environmentDetail}}</text>
            <text class="labs-catalog-boundary">{{tr.environmentBoundary}}</text>
            <view class="labs-catalog-action">
              <text>{{tr.openExperiment}}</text>
              <text aria-hidden="true">›</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
