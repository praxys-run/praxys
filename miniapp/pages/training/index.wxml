<view class="train-root {{themeClass}} {{languageClass}}">
  <nav-bar title="{{tr.navTitle}}" theme-class="{{themeClass}}" />

  <scroll-view
    scroll-y="{{true}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onScrollRefresh"
    class="train-scroll"
  >
    <view class="train-content">
      <view class="train-surface-head">
        <text class="train-surface-title">{{tr.planManagement}}</text>
        <text class="train-surface-description">{{tr.planDescription}}</text>
      </view>

      <view class="train-section">
        <road-10k-controlled-opt-in
          id="training-road-10k"
          surface="training"
          bindcheck="onRoad10KCheck"
        />
      </view>
      <view class="train-section">
        <outdoor-5k-plan-start id="training-plan-start" />
      </view>
      <view class="train-section">
        <managed-plan id="training-managed-plan" scope="window" />
      </view>
      <view class="train-section">
        <personal-context id="training-personal-context" />
      </view>
    </view>
  </scroll-view>
</view>
