<view class="history-root {{themeClass}} {{languageClass}}">
  <nav-bar
    title="{{navTitle}}"
    theme-class="{{themeClass}}"
    show-back="{{true}}"
    bindback="onBack"
  />

  <scroll-view
    scroll-y="{{true}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onScrollRefresh"
    bindscrolltolower="onScrollToBottom"
    lower-threshold="180"
    class="history-scroll"
  >
    <activity-history
      id="legacy-activity-history"
    />
  </scroll-view>
</view>
