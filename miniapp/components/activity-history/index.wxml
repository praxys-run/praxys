<template name="activity-body">
  <view class="activity-history__body">
    <view class="activity-history__glyph activity-history__glyph--{{item.glyph}}" aria-hidden="true"></view>
    <view class="activity-history__summary">
      <view class="activity-history__row-head">
        <text class="activity-history__type">{{item.type}}</text>
        <text class="activity-history__date ts-muted ts-value">{{item.date}}</text>
      </view>
      <view class="activity-history__metrics">
        <view wx:for="{{item.metrics}}" wx:key="label" wx:for-item="metric" class="activity-history__metric">
          <text class="activity-history__metric-label ts-muted">{{metric.label}}</text>
          <text class="activity-history__metric-value ts-value">{{metric.value}}</text>
        </view>
      </view>
      <view class="activity-history__secondary">
        <text wx:for="{{item.secondaryMetrics}}" wx:key="label" wx:for-item="metric">
          {{metric.label}} <text class="ts-value">{{metric.value}}</text>
        </text>
      </view>
      <view wx:if="{{item.detailAvailable}}" class="activity-history__detail-link">
        <text>{{tr.viewReport}}</text><view class="activity-history__arrow" aria-hidden="true"></view>
      </view>
    </view>
  </view>
</template>
<view class="activity-history {{tabbed ? 'activity-history--tabbed' : ''}}">
  <text wx:if="{{hasActivities}}" class="activity-history__total ts-muted ts-value">{{totalLine}}</text>

  <block wx:if="{{loading && !hasActivities}}">
    <state-card type="loading" />
    <state-card type="loading" />
    <state-card type="loading" />
  </block>

  <block wx:elif="{{errorMessage && !hasActivities}}">
    <state-card
      type="error"
      headline="{{tr.failedToLoad}}"
      detail="{{errorMessage}}"
      show-retry
      bindretry="onRetry"
    />
  </block>

  <state-card
    wx:elif="{{!hasActivities}}"
    type="empty"
    headline="{{tr.noActivities}}"
  />

  <block wx:else>
    <view wx:for="{{activities}}" wx:key="id" class="ts-card activity-history__row">
      <navigator wx:if="{{item.detailAvailable}}" url="{{item.detailUrl}}">
        <template is="activity-body" data="{{item, tr}}" />
      </navigator>
      <view wx:else><template is="activity-body" data="{{item, tr}}" /></view>
      <view class="activity-history__actions">
        <button wx:if="{{item.hasSplits}}" class="activity-history__split-toggle" data-id="{{item.id}}" bindtap="toggleExpand" aria-expanded="{{item.expanded}}">
          {{tr.splits}} <text class="ts-value">({{item.splitCount}})</text>
          <view class="activity-history__chevron {{item.expanded ? 'activity-history__chevron--open' : ''}}" aria-hidden="true"></view>
        </button>
        <button class="activity-history__dfa" data-id="{{item.id}}" data-date="{{item.activityDate}}" bindtap="onDFA">{{tr.dfa}}</button>
      </view>

      <view wx:if="{{item.hasSplits && item.expanded}}" class="activity-history__splits">
        <view
          wx:for="{{item.splitsDisplay}}"
          wx:key="num"
          wx:for-item="split"
          class="activity-history__split-row"
        >
          <text class="activity-history__split-num ts-muted ts-value">{{split.num}}</text>
          <text
            wx:for="{{split.cells}}"
            wx:key="*this"
            wx:for-item="cell"
            class="activity-history__split-cell ts-value"
          >{{cell}}</text>
        </view>
        <text wx:if="{{item.hasMoreSplits}}" class="activity-history__split-more ts-muted ts-value">
          + {{item.moreSplitsCount}} {{tr.more}}
        </text>
      </view>
      <button class="activity-history__dfa" data-id="{{item.id}}" data-date="{{item.date}}" catchtap="onDetail">{{tr.detail}}</button>
    </view>

    <text wx:if="{{loadingMore}}" class="activity-history__footer ts-muted">{{tr.loadingMore}}</text>
    <text wx:elif="{{hasReachedEnd}}" class="activity-history__footer ts-muted">{{tr.endOfActivities}}</text>
  </block>
</view>
