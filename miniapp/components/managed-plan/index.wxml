<view class="managed-plan managed-plan--{{scope}}">
  <view wx:if="{{scope === 'window'}}" class="managed-plan__header">
    <view>
      <text class="managed-plan__title">{{tr.upcomingPlan}}</text>
      <text wx:if="{{conflictCount}}" class="managed-plan__conflicts ts-warning">
        {{conflictCount}} · {{tr.reviewConflict}}
      </text>
    </view>
    <view class="managed-plan__header-actions">
      <view wx:if="{{hasResponse}}" class="managed-plan__count">
        <text class="managed-plan__count-value ts-value">{{workoutCount}}</text>
        <text class="managed-plan__count-label">{{tr.upcomingWorkouts}}</text>
      </view>
      <button
        wx:if="{{mutationAvailable}}"
        class="managed-plan__add"
        disabled="{{workingKey || refreshing || editorSaving}}"
        bindtap="onAddWorkout"
      >{{tr.addWorkout}}</button>
    </view>
  </view>

  <view
    wx:if="{{scope === 'window' && hasResponse}}"
    class="managed-plan__window-nav"
  >
    <button
      class="managed-plan__window-button"
      aria-label="{{tr.previousPlanWindow}}"
      disabled="{{refreshing || windowOffsetDays === 0}}"
      bindtap="onPreviousWindow"
    >‹</button>
    <text class="managed-plan__window-label ts-value">{{windowLabel}}</text>
    <button
      class="managed-plan__window-button"
      aria-label="{{tr.nextPlanWindow}}"
      disabled="{{refreshing}}"
      bindtap="onNextWindow"
    >›</button>
  </view>

  <view
    wx:if="{{hasResponse && hasExternalOverlap}}"
    class="managed-plan__overlap"
  >
    <text class="managed-plan__overlap-copy">{{tr.plannerOverlapWarning}}</text>
    <button
      wx:if="{{overlapReviewAvailable && canWrite}}"
      class="managed-plan__overlap-action"
      disabled="{{!canWrite || workingKey || refreshing}}"
      bindtap="onReviewFirstConflict"
    >{{tr.reviewConflict}}</button>
  </view>

  <view
    wx:if="{{hasResponse}}"
    class="managed-plan__management managed-plan__management--{{managementTone}}"
  >
    <view class="managed-plan__management-copy">
      <view class="managed-plan__management-heading">
        <view class="managed-plan__state-dot"></view>
        <text>{{managementTitle}}</text>
      </view>
      <text class="managed-plan__management-detail">{{managementDetail}}</text>
    </view>
    <button
      class="managed-plan__manage"
      bindtap="onManagePlan"
    >{{managementAction}}</button>
  </view>

  <view
    wx:if="{{hasResponse && hasAdjustment}}"
    class="managed-plan__adjustment managed-plan__adjustment--{{adjustment.tone}}"
  >
    <view class="managed-plan__adjustment-copy">
      <text class="managed-plan__adjustment-title">{{adjustment.title}}</text>
      <text class="managed-plan__adjustment-detail">{{adjustment.detail}}</text>
      <text
        wx:if="{{adjustment.contextDetail}}"
        class="managed-plan__adjustment-context"
      >{{adjustment.contextDetail}}</text>
    </view>
    <button
      wx:if="{{adjustment.canUndo}}"
      class="managed-plan__adjustment-action"
      disabled="{{adjustmentWorking || workingKey || refreshing}}"
      bindtap="onUndoAdjustment"
    >{{adjustmentWorking ? tr.restoring : tr.restoreWorkout}}</button>
  </view>

  <view wx:if="{{loading && !hasResponse}}" class="managed-plan__loading">
    <view class="ts-skeleton managed-plan__skeleton"></view>
    <view class="ts-skeleton managed-plan__skeleton managed-plan__skeleton--short"></view>
  </view>

  <view wx:elif="{{errorMessage}}" class="managed-plan__error" role="alert">
    <view class="managed-plan__error-copy">
      <text class="managed-plan__error-title">{{tr.failedToLoad}}</text>
      <text class="managed-plan__error-detail">{{errorMessage}}</text>
    </view>
    <button class="managed-plan__retry" bindtap="onRetry">{{tr.retry}}</button>
  </view>

  <block wx:elif="{{hasResponse}}">
    <text
      wx:if="{{scope === 'window' && !hasWorkouts}}"
      class="managed-plan__empty"
    >{{tr.noWorkouts}}</text>

    <view wx:if="{{hasWorkouts}}" class="managed-plan__workouts">
      <view
        wx:for="{{workouts}}"
        wx:key="key"
        class="managed-plan__workout"
      >
        <view wx:if="{{scope === 'window'}}" class="managed-plan__date">
          <text class="managed-plan__weekday">{{item.weekday}}</text>
          <text class="managed-plan__day ts-value">{{item.day}}</text>
        </view>
        <view class="managed-plan__workout-copy">
          <text class="managed-plan__workout-type">{{item.workoutType}}</text>
          <text class="managed-plan__workout-activity">{{item.activity}}</text>
          <text
            wx:if="{{item.sourceOwned}}"
            class="managed-plan__workout-source"
          >{{tr.sourceOwned}}</text>
          <text wx:if="{{item.details}}" class="managed-plan__details ts-value">{{item.details}}</text>
          <text wx:if="{{item.description && scope === 'window'}}" class="managed-plan__description">{{item.description}}</text>
        </view>
        <view class="managed-plan__workout-actions">
          <button
            wx:if="{{item.action}}"
            class="managed-plan__status managed-plan__status--{{item.statusTone}}"
            data-key="{{item.key}}"
            data-action="{{item.action}}"
            disabled="{{item.actionDisabled}}"
            bindtap="onWorkoutAction"
          >{{item.statusLabel}}</button>
          <view
            wx:else
            class="managed-plan__status managed-plan__status--static managed-plan__status--{{item.statusTone}}"
          >{{item.statusLabel}}</view>
          <button
            wx:if="{{scope === 'window' && item.canEdit}}"
            class="managed-plan__edit"
            data-key="{{item.key}}"
            disabled="{{item.editDisabled || refreshing || editorSaving}}"
            bindtap="onEditWorkout"
          >{{tr.editWorkout}}</button>
          <button
            wx:if="{{scope === 'window' && item.canDuplicate}}"
            class="managed-plan__edit"
            data-key="{{item.key}}"
            disabled="{{item.editDisabled || refreshing || editorSaving}}"
            bindtap="onDuplicateWorkout"
          >{{tr.duplicateWorkout}}</button>
        </view>
      </view>
    </view>

    <text
      wx:if="{{scope === 'window'}}"
      class="managed-plan__boundary"
    >{{tr.externalWorkoutsUntouched}}</text>
  </block>

  <text wx:if="{{actionError}}" class="managed-plan__action-error" role="alert">
    {{actionError}}
  </text>

  <view
    wx:if="{{editorOpen}}"
    class="managed-plan__editor-backdrop"
    catchtap="onCloseEditor"
  >
    <view class="managed-plan__editor" catchtap="stopPropagation">
      <view class="managed-plan__editor-handle"></view>
      <view class="managed-plan__editor-header">
        <view>
          <text wx:if="{{editorForked}}" class="managed-plan__editor-title">{{tr.duplicateWorkout}}</text>
          <text wx:elif="{{editorMode === 'edit'}}" class="managed-plan__editor-title">{{tr.editWorkout}}</text>
          <text wx:else class="managed-plan__editor-title">{{tr.addWorkout}}</text>
          <text class="managed-plan__editor-detail">
            {{editorForked ? tr.sourceStaysUnchanged : tr.externalWorkoutsUntouched}}
          </text>
        </view>
        <button
          class="managed-plan__editor-close"
          disabled="{{editorSaving}}"
          bindtap="onCloseEditor"
        >{{tr.cancel}}</button>
      </view>

      <scroll-view
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        class="managed-plan__editor-scroll"
      >
      <view class="managed-plan__editor-fields">
        <view class="managed-plan__field">
          <text class="managed-plan__field-label">{{tr.date}}</text>
          <picker
            mode="date"
            value="{{editorDate}}"
            start="{{minimumDate}}"
            disabled="{{editorSaving}}"
            bindchange="onEditorDateChange"
          >
            <view class="managed-plan__field-value ts-value">{{editorDate}}</view>
          </picker>
        </view>

        <view class="managed-plan__field">
          <text class="managed-plan__field-label">{{tr.planActivity}}</text>
          <picker
            range="{{editorActivityLabels}}"
            value="{{editorActivityIndex}}"
            disabled="{{editorSaving || editorIsRest || editorUnsupportedStructure}}"
            bindchange="onEditorActivityChange"
          >
            <view class="managed-plan__field-value">
              {{editorActivityLabels[editorActivityIndex]}}
            </view>
          </picker>
        </view>

        <view class="managed-plan__field">
          <text class="managed-plan__field-label">{{tr.workoutType}}</text>
          <picker
            range="{{editorTypeLabels}}"
            value="{{editorTypeIndex}}"
            disabled="{{editorSaving || editorUnsupportedStructure}}"
            bindchange="onEditorTypeChange"
          >
            <view class="managed-plan__field-value">
              {{editorTypeLabels[editorTypeIndex]}}
            </view>
          </picker>
        </view>

        <view
          wx:if="{{editorTypeValues[editorTypeIndex] === '__custom__'}}"
          class="managed-plan__field"
        >
          <text class="managed-plan__field-label">{{tr.customWorkoutPurpose}}</text>
          <input
            class="managed-plan__field-input"
            value="{{editorCustomPurpose}}"
            maxlength="50"
            placeholder="{{tr.raceRehearsal}}"
            disabled="{{editorSaving || editorUnsupportedStructure}}"
            bindinput="onEditorCustomPurpose"
          />
        </view>
      </view>

      <view wx:if="{{editorUnsupportedStructure}}" class="managed-plan__structured">
        <text class="managed-plan__structured-title">{{tr.newerWorkoutStructure}}</text>
        <text class="managed-plan__structured-detail">
          {{editorMode === 'edit' ? tr.unsupportedStructureDetail : tr.unsupportedStructureFork}}
        </text>
        <view class="managed-plan__editor-fields">
          <view class="managed-plan__field managed-plan__field--wide">
            <text class="managed-plan__field-label">{{tr.workoutNotes}}</text>
            <textarea
              class="managed-plan__field-textarea"
              value="{{editorDescription}}"
              maxlength="4000"
              auto-height
              placeholder="{{tr.optional}}"
              data-field="editorDescription"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            ></textarea>
          </view>
        </view>
      </view>

      <view wx:elif="{{editorStructured}}" class="managed-plan__structured">
        <view class="managed-plan__structured-heading">
          <view>
            <text class="managed-plan__structured-title">{{tr.structuredSteps}}</text>
            <text class="managed-plan__structured-detail">
              {{tr.totalsDetail}}
            </text>
          </view>
          <text class="managed-plan__structured-count ts-value">
            {{editorSummarySteps}} {{tr.step}}
          </text>
        </view>

        <view class="managed-plan__profile">
          <view class="managed-plan__profile-item">
            <text>{{tr.duration}}</text>
            <text class="ts-value">{{editorSummaryDuration}}</text>
          </view>
          <view class="managed-plan__profile-item">
            <text>{{tr.distance}}</text>
            <text class="ts-value">{{editorSummaryDistance}}</text>
          </view>
          <view class="managed-plan__profile-item">
            <text>{{tr.load}}</text>
            <text class="ts-value">{{editorSummaryLoad}}</text>
          </view>
        </view>

        <view class="managed-plan__nodes">
          <block
            wx:for="{{editorStructureView}}"
            wx:for-item="node"
            wx:for-index="rootIndex"
            wx:key="editorId"
          >
            <view wx:if="{{node.type === 'step'}}" class="managed-plan__node">
              <view class="managed-plan__node-heading">
                <text>{{tr.step}} {{rootIndex + 1}}</text>
                <view class="managed-plan__node-actions">
                  <button data-editor-id="{{node.editorId}}" data-action="move-up" disabled="{{editorSaving || rootIndex === 0}}" bindtap="onStructuredAction">{{tr.moveUp}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="move-down" disabled="{{editorSaving || rootIndex === editorStructureView.length - 1}}" bindtap="onStructuredAction">{{tr.moveDown}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="insert-before" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.insertBefore}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="insert-after" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.insertAfter}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="duplicate" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.duplicate}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="delete" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.delete}}</button>
                </view>
              </view>
              <view class="managed-plan__node-fields">
                <view class="managed-plan__field">
                  <text class="managed-plan__field-label">{{tr.stepSemantic}}</text>
                  <picker range="{{editorPhaseLabels}}" value="{{node.phaseIndex}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" bindchange="onStructuredPhaseChange">
                    <view class="managed-plan__field-value">{{editorPhaseLabels[node.phaseIndex]}}</view>
                  </picker>
                </view>
                <view class="managed-plan__field">
                  <text class="managed-plan__field-label">{{tr.optionalLabel}}</text>
                  <input class="managed-plan__field-input" value="{{node.label}}" maxlength="80" placeholder="{{tr.uphillEffort}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="label" bindinput="onStructuredInput" />
                </view>
                <view class="managed-plan__field">
                  <text class="managed-plan__field-label">{{tr.termination}}</text>
                  <picker range="{{editorTerminationLabels}}" value="{{node.terminationIndex}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" bindchange="onStructuredTerminationChange">
                    <view class="managed-plan__field-value">{{editorTerminationLabels[node.terminationIndex]}}</view>
                  </picker>
                  <input wx:if="{{node.termination.type === 'time'}}" class="managed-plan__field-input ts-value" type="number" value="{{node.termination.seconds}}" placeholder="{{tr.timeSeconds}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="seconds" bindinput="onStructuredInput" />
                  <input wx:if="{{node.termination.type === 'distance'}}" class="managed-plan__field-input ts-value" type="number" value="{{node.termination.meters}}" placeholder="{{tr.distanceMeters}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="meters" bindinput="onStructuredInput" />
                </view>
                <view class="managed-plan__field">
                  <text class="managed-plan__field-label">{{tr.targetType}}</text>
                  <picker range="{{editorTargetLabels}}" value="{{node.targetIndex}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" bindchange="onStructuredTargetChange">
                    <view class="managed-plan__field-value">{{editorTargetLabels[node.targetIndex]}}</view>
                  </picker>
                  <text class="managed-plan__field-hint">{{node.targetDetail}}</text>
                </view>
                <block wx:if="{{node.target.metric !== 'none'}}">
                  <view class="managed-plan__field">
                    <text class="managed-plan__field-label">{{tr.targetMinimum}}</text>
                    <input class="managed-plan__field-input ts-value" type="text" value="{{node.targetInputs.min}}" placeholder="{{tr.optional}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="targetMin" bindinput="onStructuredInput" bindblur="onStructuredTargetBlur" />
                  </view>
                  <view class="managed-plan__field">
                    <text class="managed-plan__field-label">{{tr.targetMaximum}}</text>
                    <input class="managed-plan__field-input ts-value" type="text" value="{{node.targetInputs.max}}" placeholder="{{tr.optional}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="targetMax" bindinput="onStructuredInput" bindblur="onStructuredTargetBlur" />
                  </view>
                </block>
                <view class="managed-plan__field managed-plan__field--wide">
                  <text class="managed-plan__field-label">{{tr.stepInstructions}}</text>
                  <textarea class="managed-plan__field-textarea" value="{{node.instructions}}" maxlength="1000" auto-height placeholder="{{tr.optionalCoachingCue}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="instructions" bindinput="onStructuredInput"></textarea>
                </view>
              </view>
            </view>

            <view wx:else class="managed-plan__node managed-plan__node--repeat">
              <view class="managed-plan__node-heading">
                <text>{{tr.repeatGroup}}</text>
                <view class="managed-plan__node-actions">
                  <button data-editor-id="{{node.editorId}}" data-action="move-up" disabled="{{editorSaving || rootIndex === 0}}" bindtap="onStructuredAction">{{tr.moveUp}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="move-down" disabled="{{editorSaving || rootIndex === editorStructureView.length - 1}}" bindtap="onStructuredAction">{{tr.moveDown}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="insert-before" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.insertBefore}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="insert-after" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.insertAfter}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="duplicate" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.duplicate}}</button>
                  <button data-editor-id="{{node.editorId}}" data-action="delete" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.delete}}</button>
                </view>
              </view>
              <view class="managed-plan__node-fields">
                <view class="managed-plan__field">
                  <text class="managed-plan__field-label">{{tr.repeatLabel}}</text>
                  <input class="managed-plan__field-input" value="{{node.label}}" maxlength="80" placeholder="{{tr.mainSet}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="repeatLabel" bindinput="onStructuredInput" />
                </view>
                <view class="managed-plan__field">
                  <text class="managed-plan__field-label">{{tr.repetitions}}</text>
                  <input class="managed-plan__field-input ts-value" type="number" value="{{node.repetitions}}" disabled="{{editorSaving}}" data-editor-id="{{node.editorId}}" data-field="repetitions" bindinput="onStructuredInput" />
                </view>
              </view>
              <text class="managed-plan__repeat-detail">{{tr.oneLevelRepeat}}</text>
              <view class="managed-plan__repeat-children">
                <block wx:for="{{node.steps}}" wx:for-item="child" wx:for-index="childIndex" wx:key="editorId">
                  <view class="managed-plan__node managed-plan__node--child">
                    <view class="managed-plan__node-heading">
                      <text>{{tr.step}} {{childIndex + 1}}</text>
                      <view class="managed-plan__node-actions">
                        <button data-editor-id="{{child.editorId}}" data-action="move-up" disabled="{{editorSaving || childIndex === 0}}" bindtap="onStructuredAction">{{tr.moveUp}}</button>
                        <button data-editor-id="{{child.editorId}}" data-action="move-down" disabled="{{editorSaving || childIndex === node.steps.length - 1}}" bindtap="onStructuredAction">{{tr.moveDown}}</button>
                        <button data-editor-id="{{child.editorId}}" data-action="insert-before" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.insertBefore}}</button>
                        <button data-editor-id="{{child.editorId}}" data-action="insert-after" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.insertAfter}}</button>
                        <button data-editor-id="{{child.editorId}}" data-action="duplicate" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.duplicate}}</button>
                        <button data-editor-id="{{child.editorId}}" data-action="delete" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.delete}}</button>
                      </view>
                    </view>
                    <view class="managed-plan__node-fields">
                      <view class="managed-plan__field">
                        <text class="managed-plan__field-label">{{tr.stepSemantic}}</text>
                        <picker range="{{editorPhaseLabels}}" value="{{child.phaseIndex}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" bindchange="onStructuredPhaseChange">
                          <view class="managed-plan__field-value">{{editorPhaseLabels[child.phaseIndex]}}</view>
                        </picker>
                      </view>
                      <view class="managed-plan__field">
                        <text class="managed-plan__field-label">{{tr.optionalLabel}}</text>
                        <input class="managed-plan__field-input" value="{{child.label}}" maxlength="80" placeholder="{{tr.uphillEffort}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" data-field="label" bindinput="onStructuredInput" />
                      </view>
                      <view class="managed-plan__field">
                        <text class="managed-plan__field-label">{{tr.termination}}</text>
                        <picker range="{{editorTerminationLabels}}" value="{{child.terminationIndex}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" bindchange="onStructuredTerminationChange">
                          <view class="managed-plan__field-value">{{editorTerminationLabels[child.terminationIndex]}}</view>
                        </picker>
                        <input wx:if="{{child.termination.type === 'time'}}" class="managed-plan__field-input ts-value" type="number" value="{{child.termination.seconds}}" placeholder="{{tr.timeSeconds}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" data-field="seconds" bindinput="onStructuredInput" />
                        <input wx:if="{{child.termination.type === 'distance'}}" class="managed-plan__field-input ts-value" type="number" value="{{child.termination.meters}}" placeholder="{{tr.distanceMeters}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" data-field="meters" bindinput="onStructuredInput" />
                      </view>
                      <view class="managed-plan__field">
                        <text class="managed-plan__field-label">{{tr.targetType}}</text>
                        <picker range="{{editorTargetLabels}}" value="{{child.targetIndex}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" bindchange="onStructuredTargetChange">
                          <view class="managed-plan__field-value">{{editorTargetLabels[child.targetIndex]}}</view>
                        </picker>
                        <text class="managed-plan__field-hint">{{child.targetDetail}}</text>
                      </view>
                      <block wx:if="{{child.target.metric !== 'none'}}">
                        <view class="managed-plan__field">
                          <text class="managed-plan__field-label">{{tr.targetMinimum}}</text>
                          <input class="managed-plan__field-input ts-value" type="text" value="{{child.targetInputs.min}}" placeholder="{{tr.optional}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" data-field="targetMin" bindinput="onStructuredInput" bindblur="onStructuredTargetBlur" />
                        </view>
                        <view class="managed-plan__field">
                          <text class="managed-plan__field-label">{{tr.targetMaximum}}</text>
                          <input class="managed-plan__field-input ts-value" type="text" value="{{child.targetInputs.max}}" placeholder="{{tr.optional}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" data-field="targetMax" bindinput="onStructuredInput" bindblur="onStructuredTargetBlur" />
                        </view>
                      </block>
                      <view class="managed-plan__field managed-plan__field--wide">
                        <text class="managed-plan__field-label">{{tr.stepInstructions}}</text>
                        <textarea class="managed-plan__field-textarea" value="{{child.instructions}}" maxlength="1000" auto-height placeholder="{{tr.optionalCoachingCue}}" disabled="{{editorSaving}}" data-editor-id="{{child.editorId}}" data-field="instructions" bindinput="onStructuredInput"></textarea>
                      </view>
                    </view>
                  </view>
                </block>
              </view>
              <button class="managed-plan__structured-action" data-editor-id="{{node.editorId}}" data-action="add-repeat-step" disabled="{{editorSaving}}" bindtap="onStructuredAction">{{tr.addRepeatStep}}</button>
            </view>
          </block>
        </view>
        <view class="managed-plan__structured-actions">
          <button class="managed-plan__structured-action" disabled="{{editorSaving}}" bindtap="onAddStructuredStep">{{tr.addStep}}</button>
          <button class="managed-plan__structured-action" disabled="{{editorSaving}}" bindtap="onAddStructuredRepeat">{{tr.addRepeat}}</button>
        </view>
        <view wx:if="{{editorUndo}}" class="managed-plan__structured-undo">
          <text>{{tr.stepRemoved}}</text>
          <button disabled="{{editorSaving}}" bindtap="onUndoStructuredDelete">{{tr.undo}}</button>
        </view>
        <view class="managed-plan__compatibility">
          <text class="managed-plan__structured-title">{{tr.providerCompatibility}}</text>
          <text class="managed-plan__structured-detail">{{tr.compatibilityDetail}}</text>
          <text wx:if="{{editorCompatibilityLoading}}" class="managed-plan__compatibility-loading">{{tr.checkingCompatibility}}</text>
          <text wx:if="{{editorCompatibilityError}}" class="managed-plan__compatibility-error">{{editorCompatibilityError}}</text>
          <text wx:if="{{!editorCompatibilityLoading && !editorCompatibilityError && editorCompatibility.length === 0}}" class="managed-plan__structured-detail">{{tr.finishStepsForCompatibility}}</text>
          <block wx:for="{{editorCompatibility}}" wx:for-item="provider" wx:key="target">
            <view class="managed-plan__compatibility-provider">
              <view class="managed-plan__compatibility-heading">
                <text>{{provider.title}}</text>
                <text class="managed-plan__compatibility-status managed-plan__compatibility-status--{{provider.tone}}">{{provider.status}}</text>
              </view>
              <text wx:if="{{provider.detail}}" class="managed-plan__structured-detail">{{provider.detail}}</text>
              <block wx:for="{{provider.reasons}}" wx:for-item="reason" wx:key="*this">
                <text class="managed-plan__compatibility-reason">{{reason}}</text>
              </block>
            </view>
          </block>
        </view>
        <view class="managed-plan__editor-fields">
          <view class="managed-plan__field managed-plan__field--wide">
            <text class="managed-plan__field-label">{{tr.workoutNotes}}</text>
            <textarea
              class="managed-plan__field-textarea"
              value="{{editorDescription}}"
              maxlength="4000"
              auto-height
              placeholder="{{tr.optional}}"
              data-field="editorDescription"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            ></textarea>
          </view>
        </view>
      </view>

      <view wx:else class="managed-plan__editor-fields">
        <view class="managed-plan__legacy-heading">
          <text class="managed-plan__structured-title">{{tr.legacyFlatSummary}}</text>
          <text class="managed-plan__structured-detail">{{tr.legacySummaryDetail}}</text>
          <button class="managed-plan__structured-action" disabled="{{editorSaving}}" bindtap="onConvertLegacyToStructured">{{tr.convertToStructured}}</button>
        </view>
        <block wx:if="{{!editorIsRest}}">
          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.durationMinutes}}</text>
            <input
              class="managed-plan__field-input ts-value"
              type="digit"
              value="{{editorDuration}}"
              placeholder="{{tr.optional}}"
              data-field="editorDuration"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.distanceKm}}</text>
            <input
              class="managed-plan__field-input ts-value"
              type="digit"
              value="{{editorDistance}}"
              placeholder="{{tr.optional}}"
              data-field="editorDistance"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.powerFloor}}</text>
            <input
              class="managed-plan__field-input ts-value"
              type="digit"
              value="{{editorPowerMin}}"
              placeholder="{{tr.optional}}"
              data-field="editorPowerMin"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.powerCeiling}}</text>
            <input
              class="managed-plan__field-input ts-value"
              type="digit"
              value="{{editorPowerMax}}"
              placeholder="{{tr.optional}}"
              data-field="editorPowerMax"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.hrMinimum}}</text>
            <input
              class="managed-plan__field-input ts-value"
              type="number"
              value="{{editorHrMin}}"
              placeholder="{{tr.optional}}"
              data-field="editorHrMin"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.hrMaximum}}</text>
            <input
              class="managed-plan__field-input ts-value"
              type="number"
              value="{{editorHrMax}}"
              placeholder="{{tr.optional}}"
              data-field="editorHrMax"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.paceMinimum}}</text>
            <input
              class="managed-plan__field-input ts-value"
              value="{{editorPaceMin}}"
              maxlength="20"
              placeholder="{{tr.paceMinExample}}"
              data-field="editorPaceMin"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>

          <view class="managed-plan__field">
            <text class="managed-plan__field-label">{{tr.paceMaximum}}</text>
            <input
              class="managed-plan__field-input ts-value"
              value="{{editorPaceMax}}"
              maxlength="20"
              placeholder="{{tr.paceMaxExample}}"
              data-field="editorPaceMax"
              disabled="{{editorSaving}}"
              bindinput="onEditorInput"
            />
          </view>
        </block>

        <view class="managed-plan__field managed-plan__field--wide">
          <text class="managed-plan__field-label">{{tr.workoutNotes}}</text>
          <textarea
            class="managed-plan__field-textarea"
            value="{{editorDescription}}"
            maxlength="4000"
            auto-height
            placeholder="{{tr.optional}}"
            data-field="editorDescription"
            disabled="{{editorSaving}}"
            bindinput="onEditorInput"
          ></textarea>
        </view>
      </view>
      </scroll-view>

      <view class="managed-plan__editor-bottom">
        <text
          wx:if="{{editorError}}"
          class="managed-plan__editor-error"
          role="alert"
        >{{editorError}}</text>

        <view
          wx:if="{{editorMode === 'edit'}}"
          class="managed-plan__editor-secondary"
        >
          <button
            class="managed-plan__editor-delete"
            disabled="{{editorSaving}}"
            bindtap="onDeleteWorkout"
          >{{tr.deleteWorkout}}</button>
          <button
            wx:if="{{!editorIsRest && !editorUnsupportedStructure}}"
            class="managed-plan__editor-rest"
            disabled="{{editorSaving}}"
            bindtap="onConvertToRest"
          >{{tr.convertToRest}}</button>
        </view>

        <button
          class="managed-plan__editor-save"
          disabled="{{editorSaving || (editorUnsupportedStructure && editorMode !== 'edit')}}"
          bindtap="onSaveWorkout"
        >
          <text wx:if="{{editorSaving}}">{{tr.saving}}</text>
          <text wx:elif="{{editorForked}}">{{tr.duplicateWorkout}}</text>
          <text wx:else>{{tr.saveWorkout}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
