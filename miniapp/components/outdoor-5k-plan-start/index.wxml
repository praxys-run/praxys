<view class="plan-start">
  <block wx:if="{{loading}}">
    <state-card type="loading" />
  </block>

  <block wx:elif="{{!capabilityAvailable}}">
    <view class="ts-card plan-start-card">
      <text class="plan-start-title">{{tr.unsupportedTitle}}</text>
      <text class="plan-start-copy">{{capabilityMessage}}</text>
    </view>
  </block>

  <block wx:else>
    <view class="ts-card plan-start-card">
      <text class="plan-start-title">{{road10kMode ? tr.road10kTitle : tr.title}}</text>
      <text class="plan-start-copy">{{road10kMode ? tr.road10kInputBody : tr.proposalNotPlan}}</text>

      <view class="plan-start-rule"></view>
      <text class="plan-start-section">{{tr.purpose}}</text>
      <text class="plan-start-copy">{{tr.purposeDetail}}</text>
      <picker mode="selector" range="{{purposeOptions}}" range-key="label" value="{{purposeIndex}}" disabled="{{working !== ''}}" bindchange="onPurposeChange">
        <view class="plan-start-picker"><text>{{purposeOptions[purposeIndex].label}}</text></view>
      </picker>
      <view wx:if="{{currentGoalUnavailable}}" class="plan-start-note">
        <text class="plan-start-note-title">{{tr.unsupportedTitle}}</text>
        <text class="plan-start-copy">{{tr.currentGoalUnavailable}}</text>
      </view>
      <view wx:if="{{purposeIsSeparate}}" class="plan-start-note">
        <text class="plan-start-note-title">{{tr.separatePurpose}}</text>
        <text class="plan-start-copy">{{tr.separatePurposeDetail}}</text>
      </view>
      <view wx:if="{{activePlanNeedsReassessment}}" class="plan-start-warning">
        <text class="plan-start-note-title">{{tr.reassessmentTitle}}</text>
        <text class="plan-start-copy">{{tr.reassessmentDetail}}</text>
      </view>
      <view wx:if="{{proposal && !proposalMatchesPurpose}}" class="plan-start-warning">
        <text class="plan-start-copy">{{tr.conflictingPurpose}}</text>
      </view>

      <block wx:if="{{selectedPurpose}}">
      <view class="plan-start-rule"></view>
      <text class="plan-start-section">{{tr.scope}}</text>
      <text class="plan-start-copy">{{road10kMode ? tr.road10kScopeDetail : tr.scopeDetail}}</text>
      <view class="plan-start-toggle {{adult ? 'plan-start-toggle--active' : ''}}" data-field="adult" bindtap="onToggleScope" aria-role="button" aria-pressed="{{adult}}"><text>{{tr.adult}}</text></view>
      <block wx:if="{{!road10kMode}}">
        <view class="plan-start-toggle {{selfCoached ? 'plan-start-toggle--active' : ''}}" data-field="selfCoached" bindtap="onToggleScope" aria-role="button" aria-pressed="{{selfCoached}}"><text>{{tr.selfCoached}}</text></view>
        <view class="plan-start-toggle {{canComplete ? 'plan-start-toggle--active' : ''}}" data-field="canComplete" bindtap="onToggleScope" aria-role="button" aria-pressed="{{canComplete}}"><text>{{tr.canComplete}}</text></view>
        <view class="plan-start-toggle {{outdoorRoad ? 'plan-start-toggle--active' : ''}}" data-field="outdoorRoad" bindtap="onToggleScope" aria-role="button" aria-pressed="{{outdoorRoad}}"><text>{{tr.outdoorRoad}}</text></view>
      </block>

      <view class="plan-start-rule"></view>
      <text class="plan-start-section">{{tr.safety}}</text>
      <text class="plan-start-copy">{{road10kMode ? tr.road10kSafetyDetail : tr.safetyDetail}}</text>
      <view class="plan-start-toggle {{safetyStop ? 'plan-start-toggle--danger' : ''}}" bindtap="onToggleSafety" aria-role="button" aria-pressed="{{safetyStop}}"><text>{{safetyStop ? (road10kMode ? tr.road10kSafetyOn : tr.safetyOn) : (road10kMode ? tr.road10kSafetyOff : tr.safetyOff)}}</text></view>

      <view class="plan-start-rule"></view>
      <text class="plan-start-section">{{tr.days}}</text>
      <text class="plan-start-copy">{{road10kMode ? tr.road10kDayDetail : tr.dayDetail}}</text>
      <view class="plan-start-days">
        <view wx:for="{{dayOptions}}" wx:key="value" class="plan-start-day {{item.selected ? 'plan-start-day--active' : ''}}" data-day="{{item.value}}" bindtap="onToggleDay" aria-role="button" aria-pressed="{{item.selected}}"><text>{{item.label}}</text></view>
      </view>

      <view wx:if="{{!road10kMode && selectedDayRows.length}}" class="plan-start-limits">
        <view wx:for="{{selectedDayRows}}" wx:key="value" class="plan-start-limit">
          <text class="plan-start-label">{{item.label}} · {{tr.timeLimit}}</text>
          <input class="plan-start-input ts-value" type="number" value="{{item.duration}}" data-day="{{item.value}}" bindinput="onDurationInput" />
        </view>
      </view>

      <view wx:if="{{road10kMode}}" class="plan-start-limits">
        <view class="plan-start-limit">
          <text class="plan-start-label">{{tr.weeklyTimeLimit}}</text>
          <input class="plan-start-input ts-value" type="number" value="{{weeklyTimeLimit}}" bindinput="onWeeklyTimeLimitInput" />
        </view>
        <view class="plan-start-limit">
          <text class="plan-start-label">{{tr.singleSessionLimit}}</text>
          <input class="plan-start-input ts-value" type="number" value="{{singleSessionLimit}}" bindinput="onSingleSessionLimitInput" />
        </view>
      </view>

      <view wx:if="{{selectedDayRows.length}}" class="plan-start-picker-wrap">
        <text class="plan-start-label">{{road10kMode ? tr.road10kLongDay : tr.longDay}}</text>
        <picker mode="selector" range="{{longDayOptions}}" value="{{longDayIndex}}" bindchange="onLongDayChange">
          <view class="plan-start-picker"><text>{{longDayOptions[longDayIndex]}}</text></view>
        </picker>
      </view>

      <view wx:if="{{road10kMode}}" class="plan-start-picker-wrap">
        <text class="plan-start-label">{{tr.benchmark}}</text>
        <picker mode="date" value="{{benchmarkDate}}" bindchange="onBenchmarkDateChange">
          <view class="plan-start-picker"><text>{{benchmarkDate || tr.benchmarkDetail}}</text></view>
        </picker>
        <text class="plan-start-copy">{{tr.benchmarkDetail}}</text>
      </view>

      <view wx:if="{{!road10kMode}}" class="plan-start-note">
        <text class="plan-start-note-title">{{tr.terrain}}</text>
        <text class="plan-start-copy">{{tr.terrainDetail}}</text>
      </view>
      <view wx:if="{{!road10kMode && perDayLimitConflict}}" class="plan-start-warning">
        <text>{{tr.perDayUnsupported}}</text>
        <text class="plan-start-copy">{{tr.perDayUnsupportedDetail}}</text>
      </view>

      <text wx:if="{{errorMessage}}" class="plan-start-error" aria-live="assertive">{{errorMessage}}</text>
      <view class="plan-start-primary" bindtap="onCheckReadiness" aria-role="button"><text>{{road10kMode ? (working === 'readiness' ? tr.roadChecking : tr.roadCheck) : (working === 'readiness' ? tr.checking : tr.check)}}</text></view>
      <view wx:if="{{readinessIsPlanReady && (!proposal || proposalMatchesPurpose) && !proposal}}" class="plan-start-secondary" bindtap="onGenerate" aria-role="button"><text>{{road10kMode ? (working === 'generate' ? tr.roadCreating : tr.roadCreate) : (working === 'generate' ? tr.creating : tr.create)}}</text></view>
      </block>
      <view wx:else class="plan-start-note">
        <text class="plan-start-copy">{{tr.purposeRequired}}</text>
      </view>
    </view>

    <view wx:if="{{readiness}}" class="ts-card plan-start-card">
      <text class="plan-start-title">{{road10kMode ? readinessBadge : tr.result}}</text>
      <text class="plan-start-badge">{{readinessBadge}}</text>
      <text class="plan-start-copy">{{readinessReason}}</text>
      <view wx:if="{{readinessContextRows.length}}" class="plan-start-version-grid">
        <block wx:for="{{readinessContextRows}}" wx:key="label">
          <text class="plan-start-copy">{{item.label}}</text>
          <text class="plan-start-copy ts-value">{{item.value}}</text>
        </block>
      </view>
      <text wx:if="{{readinessHistory}}" class="plan-start-copy ts-value">{{readinessHistory}}</text>
      <view wx:if="{{readinessAlternatives.length}}" class="plan-start-list">
        <text wx:for="{{readinessAlternatives}}" wx:key="*this" class="plan-start-copy">· {{item}}</text>
      </view>
    </view>

    <goal-baseline
      wx:if="{{readiness && showBaselineRefreshPanel}}"
      baseline="{{readiness.baseline}}"
      goal="{{readiness.purpose.goal}}"
      purpose="{{selectedPurpose}}"
      bind:refresh="onBaselineRefresh"
    />
  </block>

  <view wx:if="{{proposal}}" class="ts-card plan-start-card">
      <text class="plan-start-title">{{road10kMode ? tr.roadProposal : tr.proposal}}</text>
      <text wx:if="{{road10kMode && proposal.state === 'draft'}}" class="plan-start-badge">{{tr.roadProposalBadge}}</text>
      <text wx:else class="plan-start-badge">{{proposalStateLabel}}</text>
      <text class="plan-start-copy">{{road10kMode ? tr.roadProposalBody : tr.proposalNotPlan}}</text>
      <view class="plan-start-version-grid">
        <text class="ts-muted">{{tr.purposeLabel}}</text><text>{{proposalPurposeLabel || '—'}}</text>
        <text class="ts-muted">{{road10kMode ? tr.roadPolicy : tr.policy}}</text><text class="ts-value">{{proposal.policy_version || '—'}}</text>
        <text class="ts-muted">{{road10kMode ? tr.roadGenerator : tr.generator}}</text><text class="ts-value">{{proposal.model_version || '—'}}</text>
        <text class="ts-muted">{{road10kMode ? tr.roadScience : tr.science}}</text><text class="ts-value">{{proposal.science_version || '—'}}</text>
      </view>
      <view wx:if="{{road10kMode && proposalHasHorizon}}" class="plan-start-version-grid">
        <text class="ts-muted">{{roadTaperScience ? roadTaperScience.horizon : tr.proposalHorizon}}</text>
        <text class="ts-value">{{proposal.goal.horizon_start}} – {{proposal.goal.horizon_end}}<text wx:if="{{roadTaperScience}}"> ({{roadTaperScience.event_eve}})</text></text>
      </view>
      <view wx:if="{{road10kMode && roadTaperScience}}" class="plan-start-note">
        <text class="plan-start-note-title">{{roadTaperScience.title}}</text>
        <text class="plan-start-copy">{{roadTaperScience.body}}</text>
        <text class="ts-muted">{{roadTaperScience.source_label}} · {{roadTaperScience.source_path}}</text>
      </view>
      <view class="plan-start-workouts">
        <view wx:for="{{proposal.workouts}}" wx:key="date" class="plan-start-workout">
          <text><text class="ts-value">{{item.date}}</text> · {{item.workout_type}}</text>
          <text class="ts-value">{{item.planned_duration_min || '—'}} min</text>
        </view>
      </view>
      <text class="plan-start-copy">{{tr.inputsOnly}}</text>
      <block wx:if="{{proposal.state === 'draft'}}">
        <view wx:if="{{activePlanNeedsReassessment && proposal.goal.purpose_source === 'current_goal'}}" class="plan-start-warning">
          <text class="plan-start-copy">{{tr.adoptionPaused}}</text>
        </view>
        <view wx:if="{{proposalMatchesPurpose}}" class="plan-start-primary" bindtap="onAdopt" aria-role="button"><text>{{road10kMode ? (working === 'adopt' ? tr.roadAdopting : tr.roadAdopt) : (working === 'adopt' ? tr.adopting : tr.adopt)}}</text></view>
        <view wx:if="{{proposalMatchesPurpose}}" class="plan-start-secondary" bindtap="onRegenerate" aria-role="button"><text>{{road10kMode ? (working === 'regenerate' ? tr.roadRegenerating : tr.roadRegenerate) : (working === 'regenerate' ? tr.regenerating : tr.regenerate)}}</text></view>
        <view wx:if="{{road10kMode}}" class="plan-start-ghost" bindtap="onReviewLater" aria-role="button"><text>{{tr.roadReviewLater}}</text></view>
        <view class="plan-start-ghost" bindtap="onReject" aria-role="button"><text>{{road10kMode ? (working === 'reject' ? tr.roadRejecting : tr.roadReject) : (working === 'reject' ? tr.rejecting : tr.reject)}}</text></view>
      </block>
      <view wx:if="{{proposal.state === 'adopted'}}" class="plan-start-note">
        <text class="plan-start-note-title">{{road10kMode ? tr.roadPlanActive : tr.deliveryDisabled}}</text>
      </view>
      <view wx:if="{{proposal.state === 'expired' || proposal.state === 'rejected' || proposal.state === 'superseded'}}" class="plan-start-warning">
        <text>{{tr.lifecycle}}</text>
        <text class="plan-start-copy">{{tr.lifecycleDetail}}</text>
      </view>
  </view>

  <text wx:if="{{notice}}" class="plan-start-success">{{notice}}</text>
  <text wx:if="{{errorMessage && !capabilityAvailable}}" class="plan-start-error" aria-live="assertive">{{errorMessage}}</text>
  <view wx:if="{{errorMessage}}" class="plan-start-retry" bindtap="onRefreshProposal" aria-role="button"><text>{{tr.refresh}}</text></view>
</view>
