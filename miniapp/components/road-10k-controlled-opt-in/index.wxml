<template name="road-10k-body">
  <view class="road-10k-body">
    <block wx:if="{{languageClass === 'lang-en'}}">
      <text wx:for="{{words}}" wx:key="index" class="road-10k-word">{{item}}</text>
    </block>
    <text wx:else>{{value}}</text>
  </view>
</template>

<view wx:if="{{visible && access}}" class="road-10k-card ts-card {{languageClass}}">
  <text class="road-10k-eyebrow">{{rolloutStatusLabel}}</text>
  <text class="road-10k-title">{{rolloutTitle}}</text>
  <template
    is="road-10k-body"
    data="{{languageClass: languageClass, value: rolloutBody, words: rolloutBodyWords}}"
  />

  <block wx:if="{{surface !== 'goal'}}">
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: planStatusLabel, words: planStatusLabelWords}}"
    />
  </block>
  <block wx:elif="{{surface === 'goal' && access.rollout_status !== 'invited'}}">
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: planStatusLabel, words: planStatusLabelWords}}"
    />
  </block>

  <block wx:if="{{surface === 'goal' && access.rollout_status === 'invited'}}">
    <view class="road-10k-action road-10k-action--primary" bindtap="onReview" aria-role="button">
      <text>{{text.reviewInvitation}}</text>
    </view>
    <view class="road-10k-action road-10k-action--secondary" bindtap="onNotNow" aria-role="button">
      <text>{{text.notNow}}</text>
    </view>
  </block>

  <block wx:elif="{{surface === 'goal'}}">
    <view class="road-10k-action road-10k-action--secondary" bindtap="onOpenTraining" aria-role="button">
      <text>{{text.viewTraining}}</text>
    </view>
  </block>

  <block wx:elif="{{surface === 'training' && access.rollout_status === 'invited'}}">
    <view class="road-10k-action road-10k-action--primary" bindtap="onReview" aria-role="button">
      <text>{{text.reviewInvitation}}</text>
    </view>
    <view class="road-10k-action road-10k-action--secondary" bindtap="onNotNow" aria-role="button">
      <text>{{text.notNow}}</text>
    </view>
  </block>

  <block wx:elif="{{surface === 'training' && access.rollout_status === 'enrolled'}}">
    <view class="road-10k-action road-10k-action--primary" bindtap="onCheck" aria-role="button">
      <text>{{text.check}}</text>
    </view>
    <view class="road-10k-action road-10k-action--disabled" aria-disabled="true">
      <text>{{text.addScreenshot}}</text>
    </view>
    <view class="road-10k-disabled" aria-disabled="true">
      <text>{{screenshotHint}}</text>
    </view>
  </block>

  <block wx:elif="{{surface === 'settings'}}">
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: leaveHint, words: leaveHintWords}}"
    />
    <view
      wx:if="{{leaveAvailable}}"
      class="road-10k-action road-10k-action--secondary"
      bindtap="onLeave"
      aria-role="button"
      aria-disabled="{{leaving}}"
    >
      <text>{{leaving ? text.leaving : text.leave}}</text>
    </view>
  </block>

  <text wx:if="{{error && flow === 'idle'}}" class="road-10k-error" role="alert">{{error}}</text>
</view>

<view wx:if="{{flow === 'reauth'}}" class="road-10k-mask {{languageClass}}" aria-role="dialog">
  <view class="road-10k-sheet">
    <text class="road-10k-title">{{text.reauthTitle}}</text>
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.reauthBody, words: text.reauthBodyWords}}"
    />
    <input
      class="road-10k-input"
      password="{{true}}"
      value="{{password}}"
      bindinput="onPasswordInput"
      placeholder="{{text.passwordPlaceholder}}"
      aria-label="{{text.passwordPlaceholder}}"
    />
    <text wx:if="{{error}}" class="road-10k-error" role="alert">{{error}}</text>
    <view class="road-10k-action road-10k-action--secondary" bindtap="onCancel" aria-role="button">
      <text>{{text.cancel}}</text>
    </view>
    <view
      class="road-10k-action road-10k-action--primary {{!password ? 'road-10k-action--disabled' : ''}}"
      bindtap="onContinue"
      aria-role="button"
      aria-disabled="{{!password}}"
    >
      <text>{{text.continue}}</text>
    </view>
  </view>
</view>

<view wx:if="{{flow === 'notice'}}" class="road-10k-mask {{languageClass}}" aria-role="dialog">
  <view class="road-10k-sheet">
    <text class="road-10k-title">{{text.noticeTitle}}</text>
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.noticeIntro, words: text.noticeIntroWords}}"
    />
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.noticeScope, words: text.noticeScopeWords}}"
    />
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.noticeClaims, words: text.noticeClaimsWords}}"
    />
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.noticeControl, words: text.noticeControlWords}}"
    />
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.noticeData, words: text.noticeDataWords}}"
    />
    <template
      is="road-10k-body"
      data="{{languageClass: languageClass, value: text.noticeLeave, words: text.noticeLeaveWords}}"
    />
    <label class="road-10k-check">
      <checkbox-group bindchange="onAck"><checkbox value="ack" checked="{{acknowledged}}" /></checkbox-group>
      <text>{{text.noticeAck}}</text>
    </label>
    <text wx:if="{{error}}" class="road-10k-error" role="alert">{{error}}</text>
    <view class="road-10k-action road-10k-action--secondary" bindtap="onCancel" aria-role="button">
      <text>{{text.cancel}}</text>
    </view>
    <view
      class="road-10k-action road-10k-action--primary {{!acknowledged ? 'road-10k-action--disabled' : ''}}"
      bindtap="onJoin"
      aria-role="button"
      aria-disabled="{{!acknowledged}}"
    >
      <text>{{text.join}}</text>
    </view>
  </view>
</view>

<view wx:if="{{flow === 'joining'}}" class="road-10k-mask {{languageClass}}" aria-role="status">
  <view class="road-10k-sheet">
    <text class="road-10k-title">{{text.joining}}</text>
  </view>
</view>
